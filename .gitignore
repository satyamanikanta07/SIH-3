# =====================================================================
# NER Smart Logistics Intelligence Platform - Git Ignore Specification
# =====================================================================

# --- Dependencies ---
node_modules/
*/node_modules/
jspm_packages/

# --- Build Outputs ---
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
build/
*.local

# --- Environment Variables & Secrets ---
# Keep .env files private; friends can copy from .env.example
.env
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# --- Python & ML Virtual Environments ---
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# --- Python Packaging & Testing ---
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Runtime Uploads & Cache ---
backend/uploads/*
!backend/uploads/.gitkeep
tmp/
temp/
*.tmp

# --- IDE & Editor Settings ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Antigravity / AI Agent Workspace Metadata ---
.gemini/
.agents/
